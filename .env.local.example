# Sanity CMS — get these from your Sanity project dashboard (sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id-here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Read Token — create a token with "Viewer" role in sanity.io/manage
SANITY_API_READ_TOKEN=your-read-token-here

# Sanity Webhook Secret — set this when creating the webhook in sanity.io/manage
# Must match the secret configured in the Sanity dashboard webhook settings
SANITY_WEBHOOK_SECRET=your-webhook-secret-here

# Resend API Key — get this from resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# Boutique email address — where contact form enquiries are sent
BOUTIQUE_EMAIL=enquiries@pratimaboutique.com

# Google Maps Embed URL — get from Google Maps > Share > Embed a map > copy src URL
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=your-map-embed-params
